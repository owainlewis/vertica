{
  "name": "vertica",
  "version": "0.1.0",
  "description": "A studio for LinkedIn and Instagram carousels: one editorial design system, seven layouts, PDF and JPEG export.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch server/index.ts & vite",
    "build": "vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "sh deploy.sh"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
